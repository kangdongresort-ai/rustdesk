# Domain of the customer web page. Caddy obtains a Let's Encrypt certificate for it.
# For a LAN test without a certificate use ":80".
PORTAL_DOMAIN=support.example.com

# Public address of hbbs/hbbr (domain or IP) that customer PCs connect to.
RUSTDESK_HOST=support.example.com

# Leave empty to read the key hbbs generates in ./data/id_ed25519.pub.
RUSTDESK_KEY=

# Optional RustDesk API server (Pro / compatible API server).
RUSTDESK_API=

# The stock Windows x64 RustDesk exe, downloaded once to ./files/rustdesk.exe.
# Or leave empty and copy your own (ideally code-signed) build there.
RUSTDESK_EXE_URL=https://github.com/rustdesk/rustdesk/releases/download/1.4.4/rustdesk-1.4.4-x86_64.exe

# Downloaded file name prefix: <prefix>-qs--<config>.exe (letters, digits, _ only).
EXE_PREFIX=rustdesk

COMPANY_NAME=고객지원센터
SUPPORT_PHONE=1588-0000
SUPPORT_HOURS=평일 09:00 ~ 18:00
